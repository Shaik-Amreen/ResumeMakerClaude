# Backend environment — copy to .env and fill in values

PORT=5001
# Keep local-only unless you add authentication and intentionally expose the API.
HOST=127.0.0.1
MONGO_URI=mongodb://127.0.0.1:27017/karthikjobs

# LinkedIn/apply Chrome — KARTHIK daily profile (karthik.kovi2001@gmail.com)
# Copies auth from ~/Library/Application Support/Google/Chrome/<ORANGE_PROFILE_DIR>
ORANGE_PROFILE_DIR=Default
ORANGE_ACCOUNT_EMAIL=karthik.kovi2001@gmail.com
ORANGE_DEBUG_PORT=9333
ORANGE_HEADLESS=false

# Green Chrome — ChatGPT & Claude (KARTHIK Default profile)
GREEN_PROFILE_DIR=Default
GREEN_ACCOUNT_EMAIL=karthik.kovi2001@gmail.com
GREEN_DEBUG_PORT=9224
GREEN_HEADLESS=false

CHATGPT_URL=https://chatgpt.com/
CLAUDE_URL=https://claude.ai/chats

# LinkedIn — full-time / new-grad software roles, United States (pipe-separated)
# Override internship URLs only if you switch UI mode to Internships (legacy)
# LINKEDIN_INTERN_SEARCH_URLS=
# LINKEDIN_FT_SEARCH_URLS=
SCRAPE_MAX_JOBS=15
SCRAPE_TARGET_TOTAL=10

# Chrome cookie sync (macOS Keychain — optional if Keychain prompt fails)
SOCIAL_CHROME_KEYCHAIN_PASSWORD=

# EmailJS notifications
EMAILJS_ENABLED=true
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_FROM_NAME=AI Job Tracker
EMAILJS_TO_NAME=Karthik Kovi
EMAILJS_FROM_EMAIL=karthikkovik@gmail.com
EMAILJS_TO_EMAIL=karthikkovik@gmail.com

CHATGPT_WAIT_MS=45000
CLAUDE_WAIT_MS=45000
APPROVAL_POLL_MS=3000
APPROVAL_TIMEOUT_MS=1800000

# Built-in resume agent — FREE options (pick one)
# Recommended: local Ollama — unlimited, no API key, runs on your Mac
# Resume providers: claude-code | openrouter (OmniRoute/cloud) | ollama
RESUME_PROVIDER=claude-code
# CLAUDE_CODE_MODEL=sonnet
# CLAUDE_CODE_BINARY=
# CLAUDE_CODE_TIMEOUT_MS=900000

# Local Ollama fallback / alternate:
# RESUME_PROVIDER=ollama
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_MODEL=resumemaker
# Keep model loaded in memory between resumes (unload after idle). Examples: 30m, 5m, -1 (forever)
OLLAMA_KEEP_ALIVE=30m

# OmniRoute local gateway (OpenAI-compatible) — dashboard http://localhost:20128
# RESUME_PROVIDER=openrouter
# OPENROUTER_BASE_URL=http://127.0.0.1:20128/v1
# OPENROUTER_API_KEY=  # Dashboard → Endpoints → Local Development key
# OPENROUTER_MODEL=auto/best-coding

# Optional: OpenRouter cloud (rate-limited)
# RESUME_PROVIDER=openrouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

AUTO_RESUME_ENABLED=true

# Master pipeline — max new jobs per source (Jobright, LinkedIn, career portals)
PIPELINE_PER_SOURCE_CAP=50
CAREER_PORTAL_MAX_LINKS=12

# Auto scrape cycles (Jobright → LinkedIn → Google). Off by default so "Scrape Jobright" stays Jobright-only.
# SCHEDULER_ENABLED=true
SCHEDULER_ENABLED=false
APPLY_USE_AI=true
APPLY_OVERWRITE_ANSWERS=false
CURRENT_EXPERIENCE=3
DID_MASTERS=true
HAS_SECURITY_CLEARANCE=false
# Pipe-separated skip rules (optional — defaults are sensible)
# SKIP_BAD_WORDS=US Citizen|No C2C|security clearance
# SKIP_COMPANY_BAD_WORDS=Crossover|Staffing
# SKIP_COMPANY_GOOD_WORDS=
# SKIP_COMPANY_BLACKLIST=

# Scheduler: fulltime (default) | internship
SCHEDULER_JOB_TYPE=fulltime
